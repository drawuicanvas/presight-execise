# Rendered at container start by nginx's own entrypoint, which runs envsubst over
# /etc/nginx/templates/*.template. Only ${API_UPSTREAM} is substituted (see NGINX_ENVSUBST_FILTER
# in the Dockerfile) so nginx's own $host, $remote_addr and friends survive untouched.

server {
    listen 8086;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Hashed asset filenames, so they can be cached indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Fonts are copied verbatim from public/, so their names carry no content hash — they cannot
    # be cached immutably like /assets/ can. A month is long enough to help repeat visits and
    # short enough that replacing a font file is not stuck behind a year-long cache.
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # The API, same-origin. The trailing slash on proxy_pass strips the /api prefix, so
    # /api/users?x=1 reaches the server as /users?x=1 — its routes live at the root.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html must never be cached, or a redeploy keeps serving links to deleted asset hashes.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
