# The client calls the API at the relative path /api, which Vite proxies in dev and nginx proxies
# in the container. Same-origin by default, so nothing here is required.
#
# Set this only to call a different origin directly, bypassing the proxy — that origin must then be
# listed in the server's CORS_ORIGIN.
# VITE_API_BASE_URL=http://localhost:3000

# Where the dev proxy forwards /api. Override when something else holds port 3000.
# API_PROXY_TARGET=http://localhost:3000
